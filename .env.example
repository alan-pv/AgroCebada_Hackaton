# Configuración de la app AgroCebada
# Puerto del servidor
AGRCBDA_PORT=8090
# 127.0.0.1 solo acepta conexiones de esta máquina; 0.0.0.0 acepta las de otras
AGRCBDA_HOST=127.0.0.1
# Tamaño máximo del cuerpo de una petición, en bytes (1048576 = 1 MB); si se pasa, la app responde 413
AGRCBDA_MAX_CONTENT_LENGTH=1048576
